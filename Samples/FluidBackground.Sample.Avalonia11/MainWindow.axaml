<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FluidBackground.Avalonia11;assembly=FluidBackground.Avalonia11"
        x:Class="FluidBackground.Sample.Avalonia11.MainWindow"
        Title="FluidBackground 控件预览"
        Width="760" Height="660"
        d:DesignWidth="760" d:DesignHeight="660"
        mc:Ignorable="d"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="12">

        <!-- ============ Tab 1: 流体背景 ============ -->
        <TabItem Header="流体背景">
            <Grid RowDefinitions="220,16,*" Margin="4">

                <!-- 上方预览区域 -->
                <Border Grid.Row="0"
                        CornerRadius="12"
                        Background="#252530"
                        ClipToBounds="True">
                    <fa:FluidBackgroundControl x:Name="PreviewControl"/>
                </Border>

                <!-- 下方调节区域 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          Margin="0,8,0,0">

                        <!-- 第1行：配色方案 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="配色" Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                  x:Name="ColorCombo" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem>深海蓝紫</ComboBoxItem>
                            <ComboBoxItem>日落橙红</ComboBoxItem>
                            <ComboBoxItem>翡翠绿</ComboBoxItem>
                            <ComboBoxItem>极光</ComboBoxItem>
                            <ComboBoxItem>薰衣草</ComboBoxItem>
                            <ComboBoxItem>樱花</ComboBoxItem>
                        </ComboBox>

                        <!-- 第2行：动画模式 | 渲染模式 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="动画" Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="ModeCombo" SelectedIndex="0" Margin="0,0,8,8">
                            <ComboBoxItem>流体</ComboBoxItem>
                            <ComboBoxItem>星空</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="渲染" Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="3"
                                  x:Name="RenderModeCombo" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem>2D</ComboBoxItem>
                            <ComboBoxItem>3D</ComboBoxItem>
                            <ComboBoxItem>自动</ComboBoxItem>
                        </ComboBox>

                        <!-- 第3行：速度 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   x:Name="SpeedLabel" Text="速度:1.0" Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <Slider Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                x:Name="SpeedSlider" Minimum="0.1" Maximum="3.0" Value="1.0"
                                Margin="0,0,0,8"/>

                        <!-- 第4行：精度 -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   x:Name="QualityLabel" Text="精度:1.0x"
                                   Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <Slider Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                x:Name="QualitySlider" Minimum="1" Maximum="4" Value="1"
                                TickFrequency="0.1" IsSnapToTickEnabled="False"
                                Margin="0,0,0,8"/>

                        <!-- 第5行：浓度 -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   x:Name="DensityLabel" Text="浓度:0.30" Foreground="#A0A0B4" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <Slider Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                x:Name="DensitySlider" Minimum="0.1" Maximum="1.0" Value="0.3"
                                Margin="0,0,0,8"/>

                        <!-- 第6行：效果开关 -->
                        <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                  x:Name="MeteorCheckBox" Content="流星" IsChecked="True"
                                  IsVisible="False" Foreground="#A0A0B4" Margin="0,0,8,8"
                                  IsCheckedChanged="OnMeteorChanged"/>
                        <CheckBox Grid.Row="5" Grid.Column="3"
                                  x:Name="NebulaCheckBox" Content="星云" IsChecked="True"
                                  IsVisible="False" Foreground="#A0A0B4" Margin="0,0,0,8"
                                  IsCheckedChanged="OnNebulaChanged"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ============ Tab 2: 闪电电弧进度 ============ -->
        <TabItem Header="闪电电弧进度">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="8">

                <!-- 标题 -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="闪电电弧进度边界"
                               FontSize="20" FontWeight="Bold" Foreground="#E6E6F0"/>
                    <TextBlock Grid.Column="1"
                               Text="拖拽卡片或滑动进度条，观察电弧移动 / 抖动 / 分叉 / 残留 / 充能脉冲"
                               FontSize="12" Foreground="#7A7A90"
                               VerticalAlignment="Bottom" Margin="16,0,0,2"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- 预览卡片 -->
                <fa:LightningArcProgressControl x:Name="ArcControl"
                                                Grid.Row="1"
                                                Height="110"
                                                Margin="0,16,0,20"/>

                <!-- 主题与进度 -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*">
                    <TextBlock Grid.Column="0" Text="主题"
                               Foreground="#A0A0B4" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,24,0">
                        <ComboBoxItem>Blue White Cyan（科技冷峻）</ComboBoxItem>
                        <ComboBoxItem>Purple Navy（神秘能量）</ComboBoxItem>
                        <ComboBoxItem>Clean（危险警告）</ComboBoxItem>
                        <ComboBoxItem>Green Yellow（生化变异）</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="进度"
                               Foreground="#A0A0B4" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto">
                        <Slider x:Name="ProgressSlider" Grid.Column="0"
                                Minimum="0" Maximum="100" Value="30"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressLabel" Grid.Column="1"
                                   Text="30%" Foreground="#00F5FF" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- 说明 -->
                <TextBlock Grid.Row="3"
                           Text="进度达到 100% 时电弧会脉冲增强后稳定。拖动时抖动幅度临时增大，松开后约 0.5 秒衰减回原值。"
                           TextWrapping="Wrap" FontSize="12" Foreground="#6A6A80"
                           Margin="0,20,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
