<Window
    x:Class="FluidBackground.Sample.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fb="using:FluidBackground.WinUI"
    Title="流体背景预览">

    <Grid Background="#1E1E28" Padding="16" Width="520" Height="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上方预览区域 -->
        <Border Grid.Row="0" 
                CornerRadius="12"
                Background="#252530">
            <fb:FluidBackgroundControl x:Name="PreviewControl"/>
        </Border>

        <!-- 下方调节区域 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：配色方案 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="配色" Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                          x:Name="ColorCombo" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem>深海蓝紫</ComboBoxItem>
                    <ComboBoxItem>日落橙红</ComboBoxItem>
                    <ComboBoxItem>翡翠绿</ComboBoxItem>
                    <ComboBoxItem>极光</ComboBoxItem>
                    <ComboBoxItem>薰衣草</ComboBoxItem>
                    <ComboBoxItem>樱花</ComboBoxItem>
                </ComboBox>

                <!-- 第2行：动画模式 | 渲染模式 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="动画" Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          x:Name="ModeCombo" SelectedIndex="0" Margin="0,0,8,8">
                    <ComboBoxItem>流体</ComboBoxItem>
                    <ComboBoxItem>星空</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="渲染" Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          x:Name="RenderModeCombo" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem>2D</ComboBoxItem>
                    <ComboBoxItem>3D</ComboBoxItem>
                    <ComboBoxItem>自动</ComboBoxItem>
                </ComboBox>

                <!-- 第3行：速度 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           x:Name="SpeedLabel" Text="速度:1.0" Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <Slider Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                        x:Name="SpeedSlider" Minimum="0.1" Maximum="3.0" Value="1.0"
                        Margin="0,0,0,8"/>

                <!-- 第4行：精度 -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           x:Name="QualityLabel" Text="精度:1.0x"
                           Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <Slider Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                        x:Name="QualitySlider" Minimum="1" Maximum="4" Value="1"
                        TickFrequency="0.1"
                        Margin="0,0,0,8"/>

                <!-- 第5行：浓度 -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           x:Name="DensityLabel" Text="浓度:0.30" Foreground="#A0A0B4" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <Slider Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                        x:Name="DensitySlider" Minimum="0.1" Maximum="1.0" Value="0.3"
                        Margin="0,0,0,8"/>

                <!-- 第6行：效果开关 -->
                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                          x:Name="MeteorCheckBox" Content="流星" IsChecked="True"
                          Visibility="Collapsed" Foreground="#A0A0B4" Margin="0,0,8,8"/>
                <CheckBox Grid.Row="5" Grid.Column="3"
                          x:Name="NebulaCheckBox" Content="星云" IsChecked="True"
                          Visibility="Collapsed" Foreground="#A0A0B4" Margin="0,0,0,8"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
